# Copy to .deploy.env and fill in. Used by deploy.sh (AWS S3 + CloudFront).
# .deploy.env is ignored by git; never commit it.

# S3 bucket that holds the site files (required)
BUCKET=your-bucket-name

# Public address of the site, no trailing slash (required)
SITE_URL=https://example.com

# CloudFront distribution in front of the bucket (optional)
CLOUDFRONT_DISTRIBUTION_ID=

# Cloudflare, if it sits in front of your site (optional)
# Token needs the "Zone > Cache Purge > Purge" permission for your zone.
CF_TOKEN=
CF_ZONE_ID=
